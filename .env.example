# =============================================================================
# FinessePay environment variables
# Copy this file to `.env` (repo root and/or app folders) and fill in values.
# Never commit real secrets. Stage 0 is testnet-first.
# =============================================================================

# --- Stellar network (testnet by default) ------------------------------------
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Testnet passphrase is public (not a secret). Keep it configurable anyway.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Optional: override testnet asset issuers when they change.
# Leave empty to use the defaults in packages/stellar.
STELLAR_USDC_ISSUER=
STELLAR_USDT_ISSUER=

# --- API (apps/api) ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Comma-separated origins allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# --- Web (apps/web) ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_APP_NAME=FinessePay

# --- Future services (not wired in Stage 0) ----------------------------------
# DATABASE_URL=postgres://user:password@localhost:5432/finessepay
# REDIS_URL=redis://localhost:6379
# ANCHOR_HOME_DOMAIN=
# SEP10_JWT_SECRET=
# SEP24_TRANSFER_SERVER=
# KYC_PROVIDER_API_KEY=
# RAMP_PROVIDER_API_KEY=
# SENTRY_DSN=
