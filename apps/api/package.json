{
  "name": "@finessepay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FinessePay HTTP API \u2014 Stellar testnet account and balance lookups.",
  "scripts": {
    "dev": "node init && tsx watch src/index.ts",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/index.js",
    "clean": "rimraf dist",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@finessepay/shared": "workspace:*",
    "@finessepay/stellar": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
